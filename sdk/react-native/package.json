{
  "name": "@ouo11y/react-native",
  "version": "0.2.1",
  "description": "ouo Real User Monitoring SDK for React Native / Expo: OpenTelemetry sessions, errors, crashes, app version, fetch tracing and native session replay (iOS).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ouo11y/ouo11y.git",
    "directory": "sdk/react-native"
  },
  "homepage": "https://github.com/ouo11y/ouo11y/tree/main/sdk/react-native#readme",
  "bugs": {
    "url": "https://github.com/ouo11y/ouo11y/issues"
  },
  "keywords": [
    "opentelemetry",
    "rum",
    "real-user-monitoring",
    "session-replay",
    "react-native",
    "expo",
    "ios"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./expo-module.config.json": "./expo-module.config.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "expo-module.config.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/sync-ios.mjs && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:ios": "node scripts/sync-ios.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.21.0",
    "react": ">=18",
    "react-native": ">=0.74",
    "expo-modules-core": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "expo-modules-core": {
      "optional": true
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "jsdom": "^30.1.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
