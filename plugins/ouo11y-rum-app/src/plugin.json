{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "ouo11y RUM",
  "id": "ouo11y-rum-app",
  "info": {
    "keywords": ["app", "rum", "opentelemetry", "session replay", "ouo"],
    "description": "Real User Monitoring on OpenTelemetry: session health, sessions, timeline, traces and rrweb replay served by rum-api.",
    "author": {
      "name": "ouo11y"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Overview",
      "icon": "heart-rate",
      "path": "/a/%PLUGIN_ID%/overview",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "name": "Sessions",
      "icon": "list-ul",
      "path": "/a/%PLUGIN_ID%/sessions",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Funnels",
      "icon": "filter",
      "path": "/a/%PLUGIN_ID%/funnels",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Session detail",
      "path": "/a/%PLUGIN_ID%/sessions/:id",
      "role": "Viewer",
      "addToNav": false,
      "defaultNav": false
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/%PLUGIN_ID%",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "routes": [
    {
      "path": "rum/*",
      "method": "GET",
      "reqRole": "Viewer",
      "url": "{{ if .JsonData.rumApiUrl }}{{ .JsonData.rumApiUrl }}{{ else }}http://rum-api:8080{{ end }}",
      "headers": [
        {
          "name": "Authorization",
          "content": "Bearer {{ .SecureJsonData.readToken }}"
        }
      ]
    },
    {
      "path": "rum/v1/funnels/*",
      "method": "POST",
      "reqRole": "Viewer",
      "url": "{{ if .JsonData.rumApiUrl }}{{ .JsonData.rumApiUrl }}{{ else }}http://rum-api:8080{{ end }}/v1/funnels",
      "headers": [
        {
          "name": "Authorization",
          "content": "Bearer {{ .SecureJsonData.readToken }}"
        }
      ]
    },
    {
      "path": "rum/v1/sessions/*",
      "method": "DELETE",
      "reqRole": "Admin",
      "url": "{{ if .JsonData.rumApiUrl }}{{ .JsonData.rumApiUrl }}{{ else }}http://rum-api:8080{{ end }}/v1/sessions",
      "headers": [
        {
          "name": "Authorization",
          "content": "Bearer {{ .SecureJsonData.readToken }}"
        }
      ]
    }
  ],
  "extensions": {
    "exposedComponents": [
      {
        "id": "ouo11y-rum-app/session-detail/v1",
        "title": "ouo session detail",
        "description": "One session: header, replay player with its activity list, traces and logs."
      },
      {
        "id": "ouo11y-rum-app/sessions-list/v1",
        "title": "ouo sessions list",
        "description": "Sessions in a time range, filtered by project, app, platform, status, version and user."
      },
      {
        "id": "ouo11y-rum-app/overview-health/v1",
        "title": "ouo session health",
        "description": "Healthy, errored and crashed sessions per platform and version."
      }
    ]
  },
  "dependencies": {
    "grafanaDependency": ">=13.0.0",
    "plugins": []
  }
}
