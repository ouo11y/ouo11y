# Overrides for deploy/compose/compose.yaml. Copy to deploy/compose/.env (gitignored).
# Compose reads this file for ${VAR:-default} interpolation; deploy/scripts/*.sh source it.
# Every value here has the same default inside compose.yaml, so a fresh clone works
# without copying anything.

# --- Host ports (only if the defaults collide with something on your machine) ------
OUO_GRAFANA_PORT=3000
OUO_LOKI_PORT=3100
OUO_TEMPO_PORT=3200
OUO_MIMIR_PORT=9009
# The collector is the public ingest (ADR-0007): 4318 (OTLP/HTTP) and 4320 (Sentry bridge)
# are published on every interface; 4318 checks HTTP Basic project credentials. 4317 (gRPC)
# and the health port are published on 127.0.0.1 only.
OUO_OTLP_GRPC_PORT=4317
OUO_OTLP_HTTP_PORT=4318
OUO_SENTRY_PORT=4320
OUO_COLLECTOR_HEALTH_PORT=13133
# Internal services. Their host ports exist for laptop debugging only; a server
# install (deploy/vm) binds them to 127.0.0.1, Kubernetes does not publish them.
OUO_BACKEND_PORT=8081
OUO_MUNINN_PORT=3400
# Muninn's replay store: MinIO ports, root credentials and the bucket-scoped user
# muninn-init creates for Muninn. SECRET on anything but a laptop.
# OUO_MINIO_PORT=9000
# OUO_MINIO_CONSOLE_PORT=9001
# OUO_MINIO_ROOT_USER=minioadmin
# OUO_MINIO_ROOT_PASSWORD=minioadmin
# OUO_MUNINN_S3_BUCKET=ouo-muninn
# OUO_MUNINN_S3_ACCESS_KEY=muninn
# OUO_MUNINN_S3_SECRET_KEY=muninn-dev-secret-0000

# --- Data lifecycle (roadmap 8b, docs/operations/data-lifecycle.md) ----------------
# Retention per signal, one entry each (Go durations; Loki needs at least 24h). The same
# names are the Helm chart's `retention` values and deploy/vm's .env.
# OUO_RETENTION_LOGS=720h       # Loki retention_period
# OUO_RETENTION_TRACES=336h     # Tempo block_retention
# OUO_RETENTION_METRICS=2160h   # Mimir compactor_blocks_retention_period
# OUO_RETENTION_REPLAYS=720h    # Muninn replay retention (sweeper)
# OUO_REPLAY_SWEEP_INTERVAL=1h
# Loki deletion timings: delete requests can be cancelled for this long before the
# compactor applies them; deleted chunks are removed after the delete delay.
# OUO_LOKI_DELETE_CANCEL_PERIOD=24h
# OUO_LOKI_COMPACTION_INTERVAL=10m
# OUO_LOKI_RETENTION_DELETE_DELAY=2h

# --- Existing LGTM (only read with -f compose.external.yaml) ------------------------
# Your own Loki / Tempo / Mimir instead of the bundled ones; docs/operations/existing-lgtm.md
# lists what they need. Writes may go to your OTel collector, reads go to the backends.
# Set OUO_RETENTION_LOGS above to your Loki's retention.
# OUO_EXTERNAL_LOKI_URL=http://loki.example.internal:3100
# OUO_EXTERNAL_TEMPO_URL=http://tempo.example.internal:3200
# OUO_EXTERNAL_MIMIR_URL=http://mimir.example.internal:9009/prometheus
# OUO_EXTERNAL_OTLP_TRACES=otelcol.example.internal:4317          # OTLP gRPC host:port
# OUO_EXTERNAL_OTLP_LOGS=http://otelcol.example.internal:4318     # OTLP/HTTP base (or http://loki:3100/otlp)
# OUO_EXTERNAL_OTLP_METRICS=http://otelcol.example.internal:4318  # OTLP/HTTP base (or http://mimir:9009/otlp)
# OUO_EXTERNAL_OTLP_INSECURE=true        # false: TLS to OUO_EXTERNAL_OTLP_TRACES
# OUO_LGTM_TENANT_ID=                    # X-Scope-OrgID for multi-tenant backends; unset for single tenant
# The scripts (wait-ready.sh, smoke.sh) probe the backends from this host:
# OUO_LOKI_URL=http://loki.example.internal:3100
# OUO_TEMPO_URL=http://tempo.example.internal:3200
# OUO_MIMIR_URL=http://mimir.example.internal:9009

# --- Released images (only read with -f compose.images.yaml) -----------------------
# `docker compose -f deploy/compose/compose.yaml -f deploy/compose/compose.images.yaml up -d`
# pulls these instead of building collector/ and services/muninn. Each image has its own
# version (docs/releasing.md); pin exact versions, never latest (only the no-clone
# quickstart.yaml follows :latest). CI keeps these at the newest releases.
# Pre-releases look like 0.2.0-rc.1. Without compose.images.yaml nothing here is used and
# everything is built from source.
# The ghcr.io/ouo11y images are public: pulling them needs no docker login.
OUO_IMAGE_REGISTRY=ghcr.io/ouo11y
OUO_COLLECTOR_VERSION=0.7.0
OUO_MUNINN_VERSION=0.2.0

# --- Tokens (ADR-0007) --------------------------------------------------------------
# !!! DEVELOPMENT VALUES, LOCAL USE ONLY !!!
# !!! Everything below, plus the `demo` line in collector/projects.htpasswd, is
# !!! committed to a public repo; everybody knows these values. They are fine on a
# !!! laptop. Never use them on a machine that other people or the internet can
# !!! reach: deploy/vm/install.sh generates random ones (`openssl rand -hex 16`
# !!! prefixed pt_ / mit_ / mrt_ / mat_) and writes them here and to projects.htpasswd.
#
# Kinds of credential:
#   project token  PUBLIC. Ships inside browser bundles. Sent by every SDK as
#                  `Authorization: Basic base64("<project id>:<project token>")` to the
#                  collector (4318). Lives in collector/projects.htpasswd as
#                  `<project id>:{SHA}<base64 sha1>` (htpasswd -nbs <id> <token>), NOT
#                  in this file; the demo project is demo / pt_dev_demo_0000000000000000.
#   Muninn ingest  SECRET. Bearer the collector's otlp_http/muninn exporter presents to
#                  Muninn (POST /otlp/v1/logs). Same value on both sides.
#   Muninn read    SECRET. Bearer of Muninn's read API (replay manifests and chunks).
#   Muninn admin   SECRET. Bearer of Muninn's erasure and audit routes (`ouo-erase`).
OUO_MUNINN_INGEST_TOKEN=mit_dev_0000000000000000
OUO_MUNINN_READ_TOKEN=mrt_dev_0000000000000000
OUO_MUNINN_ADMIN_TOKEN=mat_dev_0000000000000000
# Basic credential the in-compose demo backend and Muninn use for their own OTLP
# (OTEL_EXPORTER_OTLP_HEADERS; `%20` encodes the space). Default: the `internal` project,
# so the platform's own telemetry never spends a client project's rate-limit quota.
Authorization=Basic%20aW50ZXJuYWw6cHRfZGV2X2ludGVybmFsXzAwMDAwMDAwMDAwMDAw

# --- Scripts only (deploy/scripts/smoke.sh): which project they send as -------
# Must match a line in collector/projects.htpasswd (or deploy/compose/projects.htpasswd
# on a server install, see deploy/vm/README.md). Not read by compose.
OUO_PROJECT_ID=demo
OUO_PROJECT_TOKEN=pt_dev_demo_0000000000000000

# --- VM install with TLS (deploy/vm/compose.tls.yaml, written by deploy/vm/install.sh) --
# OUO_DOMAIN=ouo.example.com            # Grafana
# OUO_OTEL_DOMAIN=otel.ouo.example.com  # the collector (SDK endpoint: OTLP)
# OUO_TLS=you@example.com               # ACME account email (Let's Encrypt), or `internal`
#                                       # for a self-signed CA on a LAN / IP address
# OUO_GRAFANA_ADMIN_PASSWORD=change-me  # generated by install.sh

# Collector CORS origins (comma separated, no spaces) and per-client rate-limit key.
OUO_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
OUO_RATELIMIT_CLIENT_KEY=address
