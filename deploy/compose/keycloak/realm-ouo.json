{
  "realm": "ouo",
  "enabled": true,
  "accessTokenLifespan": 60,
  "groups": [{ "name": "rum-support" }, { "name": "rum-engineers" }, { "name": "rum-privacy" }],
  "clients": [
    {
      "clientId": "grafana",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ouo-dev-grafana-oidc-secret",
      "redirectUris": ["${OUO_GRAFANA_ROOT_URL}/login/generic_oauth"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["basic", "profile", "email"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
