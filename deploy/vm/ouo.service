# systemd unit for the ouo stack on a VM. Installed by deploy/vm/install.sh, which
# replaces __OUO_DIR__ with the checkout directory (default /opt/ouo).
#
#   systemctl status ouo      # oneshot: active (exited) means `compose up -d` succeeded
#   systemctl restart ouo     # re-runs `up -d` (picks up .env and image changes)
#   systemctl stop ouo        # `compose down`, data volumes are kept
#
# Compose reads deploy/compose/.env automatically because the project directory is
# the directory of the first -f file.
[Unit]
Description=ouo observability stack (docker compose)
Documentation=https://github.com/ouo11y/ouo11y/blob/main/deploy/vm/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__OUO_DIR__
ExecStart=/usr/bin/docker compose -f deploy/compose/compose.yaml -f deploy/vm/compose.tls.yaml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f deploy/compose/compose.yaml -f deploy/vm/compose.tls.yaml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
