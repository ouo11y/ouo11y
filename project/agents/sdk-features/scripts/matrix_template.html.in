<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SDK Feature Matrix</title>
<!-- Generated by project/agents/sdk-features/scripts/build_matrix.py. Edit the Markdown entries, then rebuild. -->
<style>
:root{--bg:#fbfaf7;--panel:#fff;--ink:#1d2329;--muted:#5d6872;--line:#dcd8cf;--code:#f1eee7;--link:#2f62a3;
--y:#e3f4ea;--y-i:#1f6e47;--p:#fdf3e1;--p-i:#8a5a0c;--n:#fbeae7;--n-i:#a23a28;--na:#eef0f3;--na-i:#8a949e;--u:#efe8fb;--u-i:#5b3e9a;
--must:#1f6e47;--should:#2a5a97;--later:#8a5a0c;--never:#a23a28}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#14181c;--panel:#1c2228;--ink:#e6e9ec;--muted:#9aa6b1;--line:#343d46;--code:#262d34;--link:#8fb8ea;
--y:#16302a;--y-i:#7ed0a7;--p:#332814;--p-i:#e6b86c;--n:#3a201b;--n-i:#ee9a88;--na:#2a3138;--na-i:#7d8893;--u:#2a2240;--u-i:#c3a8f0;
--must:#7ed0a7;--should:#9cc1ee;--later:#e6b86c;--never:#ee9a88}}
:root[data-theme=dark]{--bg:#14181c;--panel:#1c2228;--ink:#e6e9ec;--muted:#9aa6b1;--line:#343d46;--code:#262d34;--link:#8fb8ea;
--y:#16302a;--y-i:#7ed0a7;--p:#332814;--p-i:#e6b86c;--n:#3a201b;--n-i:#ee9a88;--na:#2a3138;--na-i:#7d8893;--u:#2a2240;--u-i:#c3a8f0;
--must:#7ed0a7;--should:#9cc1ee;--later:#e6b86c;--never:#ee9a88}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif}
main{max-width:1240px;margin:0 auto;padding:40px 16px 80px}
h1{font-size:2rem;line-height:1.2;margin:0 0 8px}
h2{font-size:1.35rem;margin:44px 0 10px;padding-top:12px;border-top:1px solid var(--line)}
p,li{max-width:80ch}
.lead{color:var(--muted);font-size:1.06rem;margin:0 0 24px}
a{color:var(--link)}
code{font:.86em ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;background:var(--code);padding:1px 4px;border-radius:4px;overflow-wrap:anywhere}
.stats{display:flex;flex-wrap:wrap;gap:12px;margin:16px 0 8px}
.stat{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:10px 16px;min-width:120px}
.stat b{display:block;font-size:1.5rem;line-height:1.2}.stat span{color:var(--muted);font-size:.85rem}
.tbl{overflow-x:auto;background:var(--panel);border:1px solid var(--line);border-radius:8px}
table{border-collapse:collapse;width:100%;font-size:.88rem}
th,td{text-align:left;vertical-align:top;padding:6px 8px;border-bottom:1px solid var(--line)}
thead th{font-size:.75rem;color:var(--muted);font-weight:600;white-space:nowrap;position:sticky;top:0;background:var(--panel)}
th.v{text-align:center;border-left:1px solid var(--line)}
td.c{text-align:center;padding:6px 2px}
td:first-child code{white-space:nowrap}
td.c.first{border-left:1px solid var(--line)}
tr.group td{background:var(--code);font-weight:600;font-size:.85rem}
tr.row{cursor:pointer}
tr.row:hover td{background:var(--code)}
tr.row:focus-visible{outline:2px solid var(--link);outline-offset:-2px}
tr.detail td{background:var(--bg);padding:12px 14px}
.dot{display:inline-block;min-width:22px;padding:0 4px;border-radius:5px;font-size:.75rem;font-weight:700;line-height:20px}
.yes{background:var(--y);color:var(--y-i)}.partial{background:var(--p);color:var(--p-i)}.no{background:var(--n);color:var(--n-i)}
.na{background:var(--na);color:var(--na-i)}.unc{background:var(--u);color:var(--u-i)}.other{background:var(--na);color:var(--ink)}
.t{font-weight:700;font-size:.8rem;white-space:nowrap}
.t.must{color:var(--must)}.t.should{color:var(--should)}.t.later{color:var(--later)}.t.never{color:var(--never)}
.filters{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:0 0 12px}
button{font:inherit;font-size:.86rem;padding:4px 12px;border:1px solid var(--line);border-radius:16px;background:var(--panel);color:var(--ink);cursor:pointer}
button[aria-pressed=true]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
input[type=search]{font:inherit;font-size:.9rem;padding:4px 10px;border:1px solid var(--line);border-radius:16px;background:var(--panel);color:var(--ink);min-width:200px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px;margin-top:10px}
.cell{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:8px 10px;font-size:.84rem;overflow-wrap:anywhere}
.cell h4{margin:0 0 4px;font-size:.8rem;color:var(--muted)}
.legend{display:flex;flex-wrap:wrap;gap:14px;font-size:.85rem;color:var(--muted);margin:8px 0 16px}
.muted{color:var(--muted)}
</style>
</head>
<body>
<main>
<h1>Client SDK feature matrix</h1>
<p class="lead">Step 4 of the post-MVP plan, 2026-11-10. Every feature of the <a href="catalog.md">catalog</a>, what Sentry, Datadog and PostHog ship on web, iOS, Android and React Native, and the target we recommend. Targets are proposals for the founder. Evidence and sources are in <a href="vendors/index.md">the vendor files</a>; gaps in the spec are in <a href="gaps-for-step-7.md">gaps-for-step-7.md</a>.</p>

<div class="stats" id="stats"></div>

<h2>Headline</h2>
<ol>
<li><b>Must</b> is the full story on OTel: sessions, errors and crashes, vitals and app start, HTTP spans with W3C <code>traceparent</code>, clicks and frustration, navigation, web and mobile replay with an on-error buffer, consent and masking, offline delivery, symbolication. The draft spec already covers most of it.</li>
<li><b>None of the three vendors sends RUM as OTLP.</b> PostHog sends only its logs as OTLP. For backend joins, Datadog sends W3C <code>traceparent</code> plus its own headers to an allowlist, Sentry sends its own headers with <code>traceparent</code> opt-in, and PostHog sends only its own session headers.</li>
<li><b>Should</b> fills the gaps vendors have taught users to expect: time to full display, OOM and exit reasons, console logs, feature-flag evaluations, a feedback API, remote kill switch, WebView bridging, bot filtering.</li>
<li><b>Never</b> is product analytics: autocapture, identify and alias, experiments, surveys, a flag service, client metrics, separate trace or error sampling.</li>
<li>The mobile replay format is <b>not decided</b> here. The evidence is in <a href="mobile-replay-format-evidence.md">mobile-replay-format-evidence.md</a>: Sentry is video, Datadog is wireframe, PostHog ships both.</li>
</ol>

<h2>Every feature</h2>
<div class="legend">
<span><span class="dot yes">Y</span> has it</span><span><span class="dot partial">~</span> partial, opt-in elsewhere, or paid add-on</span>
<span><span class="dot no">N</span> does not</span><span><span class="dot unc">?</span> uncertain</span><span><span class="dot na">–</span> n/a or not researched</span>
<span><span class="dot other">·</span> see detail</span>
</div>
<div class="filters" role="group" aria-label="Filter by target">
<button data-t="all" aria-pressed="true">All</button>
<button data-t="must" aria-pressed="false">Must</button>
<button data-t="should" aria-pressed="false">Should</button>
<button data-t="later" aria-pressed="false">Later</button>
<button data-t="never" aria-pressed="false">Never</button>
<button data-t="gap" aria-pressed="false">Spec gap</button>
<button id="extras" aria-pressed="false">Show vendor extras</button>
<input type="search" id="q" placeholder="Search features" aria-label="Search features">
</div>
<p class="muted" style="font-size:.88rem;margin:0 0 8px">Click a row for each vendor's configuration, default, limits and source.</p>
<div class="tbl"><table id="t">
<thead>
<tr><th rowspan="2">ID</th><th rowspan="2">Feature</th><th rowspan="2">Target</th><th rowspan="2">Where</th>
<th class="v" colspan="4">Sentry</th><th class="v" colspan="4">Datadog</th><th class="v" colspan="4">PostHog</th></tr>
<tr><th class="v">Web</th><th>iOS</th><th>And.</th><th>RN</th><th class="v">Web</th><th>iOS</th><th>And.</th><th>RN</th><th class="v">Web</th><th>iOS</th><th>And.</th><th>RN</th></tr>
</thead>
<tbody></tbody>
</table></div>

<h2>How this was made</h2>
<p>Seven research passes on 2026-11-10 read each vendor's current docs and the source of its SDKs at the latest release tag, and recorded the default from code where docs and code disagreed. Versions: Sentry JavaScript 11.11.0, Cocoa 9.33.0, Java 8.63.0, React Native 8.34.0; Datadog Browser 7.17.0, iOS 3.21.0, Android 3.16.0, React Native 3.11.0; PostHog JS 1.447.6, iOS 3.94.3, Android 3.76.1, React Native 4.85.4. Docs pages carry no update date, so they are cited as accessed on 2026-11-10. This page is generated from the Markdown entries by <code>project/agents/sdk-features/scripts/build_matrix.py</code>.</p>
</main>
<script>
const D = /*DATA*/;
const P = ["web","ios","android","rn"], PN = {web:"Web",ios:"iOS",android:"Android",rn:"RN"};
const SYM = {yes:"Y",partial:"~",no:"N",unc:"?",na:"–",other:"·"};
const st = document.getElementById("stats");
st.innerHTML = `<div class="stat"><b>${D.rows.length}</b><span>features</span></div>` +
  ["must","should","later","never"].map(k=>`<div class="stat"><b>${D.counts[k]}</b><span>${k[0].toUpperCase()+k.slice(1)}</span></div>`).join("") +
  `<div class="stat"><b>${D.rows.filter(r=>/G\d/.test(r.spec)).length}</b><span>rows with a spec gap</span></div>`;
let tfilter = "all", showExtras = false, q = "";
const tb = document.querySelector("#t tbody");
function cellsHtml(c){
  return D.vendors.map(v=>P.map((p,i)=>{const e=(c[v]||{})[p]; const s=e?e.s:"na";
    return `<td class="c${i===0?" first":""}"><span class="dot ${s}" title="${D.vnames[v]} ${PN[p]}: ${s}">${SYM[s]}</span></td>`}).join("")).join("");
}
function detailHtml(r){
  const parts = [];
  if (r.why) parts.push(`<p><b>Why:</b> ${r.why}</p><p><b>Spec:</b> ${r.spec}</p>`);
  if (r.full) parts.push(`<p class="muted">Catalog: ${r.full}</p>`);
  const cards = [];
  for (const v of D.vendors) for (const p of P) { const e=(r.cells[v]||{})[p]; if (e && e.s!=="na") cards.push(`<div class="cell"><h4>${D.vnames[v]} · ${PN[p]}</h4>${e.t}</div>`); }
  parts.push(cards.length?`<div class="grid">${cards.join("")}</div>`:`<p class="muted">Not applicable on any platform, for every vendor.</p>`);
  return parts.join("");
}
function match(r){
  if (q && !(r.id+" "+r.name+" "+(r.full||"")+" "+(r.why||"")).toLowerCase().includes(q)) return false;
  if (tfilter==="all") return true;
  if (tfilter==="gap") return /G\d/.test(r.spec||"");
  return r.target===tfilter;
}
function render(){
  const out = [];
  for (const [g,label] of D.groups){
    const rows = D.rows.filter(r=>r.g===g && match(r));
    const ex = showExtras ? D.extras.filter(r=>r.g===g && (!q || (r.id+r.name).toLowerCase().includes(q)) && (tfilter==="all")) : [];
    if (!rows.length && !ex.length) continue;
    out.push(`<tr class="group"><td colspan="16">${label}</td></tr>`);
    for (const r of rows) out.push(`<tr class="row" tabindex="0" data-id="${r.id}"><td><code>${r.id}</code></td><td>${r.name}</td><td><span class="t ${r.target}">${r.target}</span></td><td>${r.where}</td>${cellsHtml(r.cells)}</tr>`);
    for (const r of ex) out.push(`<tr class="row" tabindex="0" data-x="${r.vendor}|${r.id}|${r.kind}"><td><code>${r.id}</code></td><td><span class="muted">${r.vendor} extra:</span> ${r.name}</td><td class="muted">–</td><td>${r.kind==="web"?"W":"M"}</td>${cellsHtml(r.cells)}</tr>`);
  }
  tb.innerHTML = out.join("") || `<tr><td colspan="16" class="muted">No feature matches.</td></tr>`;
}
function toggle(tr){
  const next = tr.nextElementSibling;
  if (next && next.classList.contains("detail")) { next.remove(); return; }
  let r;
  if (tr.dataset.id) r = D.rows.find(x=>x.id===tr.dataset.id);
  else { const [v,id,k]=tr.dataset.x.split("|"); r = D.extras.find(x=>x.vendor===v&&x.id===id&&x.kind===k); }
  const d = document.createElement("tr"); d.className="detail"; d.innerHTML = `<td colspan="16">${detailHtml(r)}</td>`;
  tr.after(d);
}
tb.addEventListener("click", e=>{ if (e.target.closest("a")) return; const tr=e.target.closest("tr.row"); if (tr) toggle(tr); });
tb.addEventListener("keydown", e=>{ if ((e.key==="Enter"||e.key===" ") && e.target.matches("tr.row")) { e.preventDefault(); toggle(e.target); } });
document.querySelectorAll("button[data-t]").forEach(b=>b.addEventListener("click",()=>{
  tfilter=b.dataset.t; document.querySelectorAll("button[data-t]").forEach(x=>x.setAttribute("aria-pressed", String(x===b))); render();
}));
document.getElementById("extras").addEventListener("click", e=>{ showExtras=!showExtras; e.currentTarget.setAttribute("aria-pressed", String(showExtras)); render(); });
document.getElementById("q").addEventListener("input", e=>{ q=e.target.value.trim().toLowerCase(); render(); });
render();
</script>
</body>
</html>
