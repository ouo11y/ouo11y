<title>ouo SDK state</title>
<!-- Generated by project/agents/sdk-state/scripts/build_report.py from project/agents/sdk-state/findings/. Do not edit by hand. -->
<style>
:root{color-scheme:light;--bg:#f9f9f7;--surface:#fcfcfb;--ink:#0b0b0b;--ink2:#52514e;--muted:#898781;--grid:#e1e0d9;--axis:#c3c2b7;--ring:rgba(11,11,11,.10);
--s1:#2a78d6;--s2:#eb6834;--s0:#898781;--good:#0ca30c;--warn:#fab219;--crit:#d03b3b;--na:#c3c2b7;--chipink:#fff;--warnink:#0b0b0b;--link:#1c5cab}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--bg:#0d0d0d;--surface:#1a1a19;--ink:#f0efec;--ink2:#c3c2b7;--muted:#898781;--grid:#2c2c2a;--axis:#383835;--ring:rgba(255,255,255,.10);--s1:#3987e5;--s2:#d95926;--na:#383835;--link:#86b6ef}}
:root[data-theme="dark"]{color-scheme:dark;--bg:#0d0d0d;--surface:#1a1a19;--ink:#f0efec;--ink2:#c3c2b7;--muted:#898781;--grid:#2c2c2a;--axis:#383835;--ring:rgba(255,255,255,.10);--s1:#3987e5;--s2:#d95926;--na:#383835;--link:#86b6ef}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
main{max-width:1180px;margin:0 auto;padding:24px 16px 64px}
a{color:var(--link)}
h1{font-size:26px;margin:0 0 4px}h2{font-size:20px;margin:40px 0 8px;padding-top:8px;border-top:1px solid var(--grid)}h3{font-size:16px;margin:24px 0 6px}
p{max-width:78ch;color:var(--ink2)}.muted{color:var(--muted);font-size:13px}
nav.toc{display:flex;flex-wrap:wrap;gap:6px 14px;margin:12px 0 0;font-size:14px}
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin:16px 0}
.tile{background:var(--surface);border:1px solid var(--ring);border-radius:10px;padding:14px}
.big{font-size:30px;font-weight:600}.of{font-size:16px;color:var(--muted);font-weight:400}
.panel{background:var(--surface);border:1px solid var(--ring);border-radius:10px;padding:14px;margin:12px 0}
svg{width:100%;height:auto;display:block}
svg .grid{stroke:var(--grid);stroke-width:1}svg .tick{fill:var(--muted);font-size:11px}svg .lab{fill:var(--ink2);font-size:12px}svg .val{fill:var(--ink);font-size:12px;font-variant-numeric:tabular-nums}
svg .s1{fill:var(--s1)}svg .s2{fill:var(--s2)}svg .s0{fill:var(--s0)}svg .good{fill:var(--good)}svg .warn{fill:var(--warn)}svg .crit{fill:var(--crit)}
svg .whisk{stroke:var(--ink);stroke-width:2;opacity:.55}svg .inbar{fill:#fff;font-size:12px;font-weight:600}svg .inbar.dark{fill:#0b0b0b}
.legend{display:flex;flex-wrap:wrap;gap:14px;font-size:13px;color:var(--ink2);margin:6px 0}.sw{display:inline-block;width:12px;height:12px;border-radius:3px;vertical-align:-1px;margin-right:5px}
.charts{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr));gap:12px}
figure.chart{margin:0;background:var(--surface);border:1px solid var(--ring);border-radius:10px;padding:12px}figure.chart figcaption{font-size:14px;margin-bottom:6px}.unit{color:var(--muted);font-weight:400}.note{font-size:12px;margin:6px 0 0}
.filters{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:10px 0}
.filters select,.filters input{font:inherit;font-size:14px;padding:5px 8px;border-radius:6px;border:1px solid var(--axis);background:var(--surface);color:var(--ink)}
.scroll{overflow-x:auto;border:1px solid var(--ring);border-radius:10px;background:var(--surface)}
table{border-collapse:collapse;width:100%;font-size:13px}
th,td{text-align:left;vertical-align:top;padding:6px 8px;border-bottom:1px solid var(--grid)}th{position:sticky;top:0;background:var(--surface);font-weight:600;color:var(--ink2)}
td.num{font-variant-numeric:tabular-nums}
tr.row{cursor:pointer}tr.row:hover td{background:color-mix(in srgb,var(--s1) 6%,transparent)}
tr.detail td{background:color-mix(in srgb,var(--ink) 3%,transparent);font-size:12.5px}
.chip{display:inline-block;min-width:66px;padding:1px 6px;border-radius:999px;font-size:11.5px;font-weight:600;color:var(--chipink);text-align:center;white-space:nowrap}
.chip.met,.chip.full,.chip.g-none,.chip.g-ahead{background:var(--good)}.chip.partial,.chip.g-medium{background:var(--warn);color:var(--warnink)}.chip.not_met,.chip.none,.chip.g-large{background:var(--crit)}
.chip.na,.chip.unknown,.chip.uncertain,.chip.g-unknown,.chip.g-target{background:var(--na);color:var(--ink)}
code{font-size:12px;word-break:break-all}
ul.ev{margin:4px 0;padding-left:18px}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:12px}.cols>*,.charts>*{min-width:0}.panel,td{overflow-wrap:anywhere}
@media (max-width:640px){th.hide-s,td.hide-s{display:none}}
</style>
</head>
<body>
<main>
<h1>ouo SDK state</h1>
<p class="muted">Step 5 of the post-MVP plan, 2026-11-10. How the browser, iOS, Android and React Native SDKs on <code>main</code> compare with the draft SDK spec (<code>0.1.0-draft</code>), with Sentry's SDKs, and what they cost on a device. Entries: <a href="index.md">client-sdk-state</a>.</p>
<nav class="toc"><a href="#compliance">Compliance</a><a href="#table">All requirements</a><a href="#violations">Violations</a><a href="#gaps">Sentry gaps</a><a href="#overhead">Overhead</a><a href="#budgets">Proposed budgets</a><a href="#method">Method</a></nav>

<h2 id="compliance">Spec compliance</h2>
<p>Each SDK against every MUST in the spec that applies to its platform. "Partly met" means a real part of the rule holds. The Android row judges what a native Android app gets from <code>sdk/android</code> alone: today that code runs only inside the React Native SDK.</p>
<div class="tiles">@@HEADLINE@@</div>
<div class="panel">
<div class="legend"><span><span class="sw" style="background:var(--good)"></span>Met</span><span><span class="sw" style="background:var(--warn)"></span>Partly met</span><span><span class="sw" style="background:var(--crit)"></span>Not met</span></div>
@@STACKED@@
</div>
<h3>How each SDK is built</h3>
<div class="cols" id="arch"></div>

<h2 id="table">All requirements</h2>
<p>All 199 requirement ids. Click a row for the evidence (<code>file:line</code> on <code>main</code> at 3e9e2c11), the method and the note per platform.</p>
<div class="filters">
<input id="q" type="search" placeholder="Search id or text" aria-label="Search requirements">
<select id="fsec" aria-label="Section"><option value="">All sections</option></select>
<select id="flev" aria-label="Level"><option value="">All levels</option><option>MUST</option><option>SHOULD</option><option>MAY</option><option>informative</option></select>
<select id="fplat" aria-label="Platform"><option value="">Any platform</option><option value="web">Web</option><option value="ios">iOS</option><option value="android">Android</option><option value="rn">React Native</option></select>
<select id="fstat" aria-label="Status"><option value="">Any status</option><option value="met">Met</option><option value="partial">Partly met</option><option value="not_met">Not met</option><option value="na">Not applicable</option></select>
<span class="muted" id="ccount"></span>
</div>
<div class="scroll"><table id="ctab"><thead><tr><th>Id</th><th class="hide-s">Requirement</th><th>Web</th><th>iOS</th><th>Android</th><th>RN</th></tr></thead><tbody></tbody></table></div>

<h2 id="violations">What the SDKs do that the spec does not allow</h2>
<div class="cols" id="viol"></div>

<h2 id="gaps">ouo against Sentry, per feature</h2>
<p>Step 4's Must and Should features. "Ours" comes from the audits above; "Sentry" from Step 4's vendor research (sentry-javascript 11.11.0, sentry-cocoa 9.33.0, sentry-java 8.63.0, sentry-react-native 8.34.0). Gap: <strong>large</strong> = Sentry has it, we do not; <strong>medium</strong> = one level apart; <strong>none</strong> = level with Sentry; <strong>ahead</strong> = we have more; <strong>target only</strong> = neither has it fully, so the gap is to our own target. Effort is a rough size to close it: S up to a week, M one to three weeks, L more.</p>
<div class="filters">
<select id="gt" aria-label="Target"><option value="">Must and Should</option><option>Must</option><option>Should</option></select>
<select id="gg" aria-label="Gap"><option value="">Any gap</option><option value="large">Large on some platform</option><option value="medium">Medium or larger</option></select>
<select id="ge" aria-label="Effort"><option value="">Any effort</option><option>S</option><option>M</option><option>L</option></select>
<span class="muted" id="gcount"></span>
</div>
<div class="scroll"><table id="gtab"><thead><tr><th>Feature</th><th>Target</th><th>Web</th><th>iOS</th><th>Android</th><th>RN</th><th>Effort</th></tr></thead><tbody></tbody></table></div>

<h2 id="overhead">Overhead</h2>
<p>@@OVERHEAD_SETUP@@</p>
<div class="legend"><span><span class="sw" style="background:var(--s1)"></span>ouo</span><span><span class="sw" style="background:var(--s2)"></span>Sentry</span><span><span class="sw" style="background:var(--s0)"></span>No SDK (baseline)</span><span>Whiskers: lowest to highest run</span></div>
@@CHARTS@@

<h2 id="budgets">Proposed budgets for spec section 13</h2>
<p>Proposals for Step 7, not decisions. Each number sits above what ouo measures today with room for the spec work still to come (OTLP replay, consent, view ids), and is checked the way the last column says.</p>
<div class="scroll"><table><thead><tr><th>Budget</th><th>Web</th><th>iOS</th><th>Android</th><th>RN</th><th>Basis</th><th>How CI enforces it</th></tr></thead><tbody>@@BUDGETS@@</tbody></table></div>

<h3>Not measured</h3>
<ul>@@NOTMEASURED@@</ul>

<h2 id="method">Method</h2>
<div class="cols" id="meta"></div>
</main>
<script id="data" type="application/json">@@DATA@@</script>
<script>
const D = JSON.parse(document.getElementById("data").textContent);
const P = [["web","Web"],["ios","iOS"],["android","Android"],["rn","React Native"]];
const L = {met:"Met",partial:"Partly",not_met:"Not met",na:"n/a",full:"Full",none:"None",unknown:"Unknown",uncertain:"Uncertain"};
const G = {large:"Large",medium:"Medium",none:"None",ahead:"Ahead",target:"Target only",unknown:"Unknown"};
const el = (t, a = {}, ...k) => { const e = document.createElement(t); for (const [n, v] of Object.entries(a)) n === "class" ? e.className = v : e.setAttribute(n, v); for (const c of k) e.append(c); return e; };
const chip = (cls, text) => el("span", { class: "chip " + cls }, text);
for (const [p, n] of P) {
  document.getElementById("arch").append(el("div", { class: "panel" }, el("strong", {}, n + " "), el("span", { class: "muted" }, D.meta[p].version), el("p", {}, D.arch[p])));
  const ul = el("ul", { class: "ev" });
  for (const v of D.viol[p]) ul.append(el("li", {}, el("strong", {}, v.breaks + ": "), v.what, " ", el("code", {}, (v.evidence || []).slice(0, 2).join(", "))));
  document.getElementById("viol").append(el("div", { class: "panel" }, el("strong", {}, `${n} (${D.viol[p].length})`), ul));
  document.getElementById("meta").append(el("div", { class: "panel" }, el("strong", {}, n), el("p", {}, D.meta[p].how)));
}
const secs = [...new Set(D.comp.map((r) => r.section))];
for (const s of secs) document.getElementById("fsec").append(el("option", {}, s));
function renderC() {
  const q = document.getElementById("q").value.toLowerCase(), s = document.getElementById("fsec").value, lv = document.getElementById("flev").value;
  const fp = document.getElementById("fplat").value, fs = document.getElementById("fstat").value;
  const tb = document.querySelector("#ctab tbody"); tb.replaceChildren(); let n = 0;
  for (const r of D.comp) {
    if (q && !(r.id.toLowerCase().includes(q) || r.text.toLowerCase().includes(q))) continue;
    if (s && r.section !== s) continue; if (lv && r.level !== lv) continue;
    if (fs && !(fp ? r.p[fp].status === fs : P.some(([p]) => r.p[p].status === fs))) continue;
    n++;
    const tr = el("tr", { class: "row", tabindex: "0" }, el("td", {}, el("strong", {}, r.id), el("div", { class: "muted" }, r.level)), el("td", { class: "hide-s" }, r.text));
    for (const [p] of P) tr.append(el("td", {}, chip(r.p[p].status, L[r.p[p].status])));
    const det = el("tr", { class: "detail", hidden: "" });
    const td = el("td", { colspan: "6" }, el("div", { class: "muted" }, r.section));
    for (const [p, nm] of P) { const x = r.p[p]; const ul = el("ul", { class: "ev" }); for (const e of x.evidence) ul.append(el("li", {}, el("code", {}, e))); td.append(el("div", {}, el("strong", {}, `${nm}: ${L[x.status]}`), ` (${x.method}) ${x.note}`, ul)); }
    det.append(td);
    const tog = () => det.hidden = !det.hidden; tr.onclick = tog; tr.onkeydown = (e) => { if (e.key === "Enter") tog(); };
    tb.append(tr, det);
  }
  document.getElementById("ccount").textContent = `${n} of ${D.comp.length}`;
}
for (const id of ["q", "fsec", "flev", "fplat", "fstat"]) document.getElementById(id).addEventListener("input", renderC);
function renderG() {
  const t = document.getElementById("gt").value, g = document.getElementById("gg").value, e = document.getElementById("ge").value;
  const tb = document.querySelector("#gtab tbody"); tb.replaceChildren(); let n = 0;
  for (const r of D.gaps) {
    const gs = Object.values(r.platforms).map((v) => v.gap);
    if (t && r.target !== t) continue; if (e && r.effort.size !== e) continue;
    if (g === "large" && !gs.includes("large")) continue; if (g === "medium" && !gs.some((x) => x === "large" || x === "medium")) continue;
    n++;
    const tr = el("tr", { class: "row", tabindex: "0" }, el("td", {}, el("strong", {}, r.id), " ", r.feature), el("td", {}, r.target));
    for (const [p] of P) { const v = r.platforms[p]; tr.append(el("td", {}, v ? el("div", {}, chip("g-" + v.gap, G[v.gap]), el("div", { class: "muted" }, `ours ${L[v.ours] || v.ours}, Sentry ${L[v.sentry] || v.sentry}`)) : el("span", { class: "muted" }, "does not apply"))); }
    tr.append(el("td", {}, el("strong", {}, r.effort.size || "")));
    const det = el("tr", { class: "detail", hidden: "" }); const td = el("td", { colspan: "7" }, el("div", {}, el("strong", {}, "To close: "), r.effort.note || ""));
    for (const [p, nm] of P) { const v = r.platforms[p]; if (!v) continue; td.append(el("div", {}, el("strong", {}, nm + ": "), `ours: ${v.ours_note} `, el("code", {}, (v.ours_evidence || []).slice(0, 2).join(", ")), el("div", { class: "muted" }, "Sentry: " + v.sentry_note))); }
    det.append(td); const tog = () => det.hidden = !det.hidden; tr.onclick = tog; tr.onkeydown = (ev) => { if (ev.key === "Enter") tog(); };
    tb.append(tr, det);
  }
  document.getElementById("gcount").textContent = `${n} features`;
}
for (const id of ["gt", "gg", "ge"]) document.getElementById(id).addEventListener("input", renderG);
renderC(); renderG();
</script>
</body>
</html>
