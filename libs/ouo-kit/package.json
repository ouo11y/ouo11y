{
  "name": "@ouo11y/kit",
  "version": "0.1.0",
  "description": "Frontend building blocks for ouo11y client plugins: a replay player that plays a Muninn manifest with chunks the caller fetches, and the replay format seam. React only; no Grafana and no backend of ours required.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ouo11y/ouo11y.git",
    "directory": "libs/ouo-kit"
  },
  "homepage": "https://github.com/ouo11y/ouo11y/tree/main/libs/ouo-kit#readme",
  "bugs": {
    "url": "https://github.com/ouo11y/ouo11y/issues"
  },
  "keywords": [
    "opentelemetry",
    "rum",
    "session-replay",
    "rrweb",
    "react"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "rrweb-player": "2.1.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "jsdom": "^30.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
