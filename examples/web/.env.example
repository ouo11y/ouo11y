# Copy to .env (or .env.local) and adjust. Defaults match the stock ports in deploy/docker/.env.example.
# OTLP/HTTP endpoint of the OpenTelemetry Collector (traces, logs, metrics).
VITE_OTLP_ENDPOINT=http://localhost:4318
# rum-api base URL (replay chunk upload), see deploy/docker/.env OUO_RUM_API_PORT.
VITE_RUM_API=http://localhost:8080
# Demo backend (examples/backend).
VITE_BACKEND_URL=http://localhost:8081
# Reported as service.version on every signal.
VITE_APP_VERSION=1.4.2
# Set to 1 to build against src/rum-stub.ts instead of the @ouo/browser package.
# VITE_RUM_STUB=1
# Set to 1 to enable SDK debug logging.
# VITE_RUM_DEBUG=1
