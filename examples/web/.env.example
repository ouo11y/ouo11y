# Copy to .env (or .env.local) and adjust. Defaults match the stock ports in deploy/docker/.env.example.
# rum-api base URL. The SDK sends OTLP to ${VITE_RUM_API}/ingest/otlp/v1/{traces,logs} and
# replay chunks to ${VITE_RUM_API}/v1/replay/chunks (ADR-0007). See deploy/docker/.env OUO_RUM_API_PORT.
VITE_RUM_API=http://localhost:8080
# Public project token sent as X-Ouo-Project-Token on every ingest request. Not a secret: it only
# names the project. This is the development token the local stack is provisioned with
# (deploy/docker/.env.example OUO_PROJECT_TOKEN); use your project's token elsewhere.
VITE_OUO_PROJECT_TOKEN=pt_dev_demo_0000000000000000
# Demo backend (examples/backend).
VITE_BACKEND_URL=http://localhost:8081
# Reported as service.version on every signal.
VITE_APP_VERSION=1.4.2
# Set to 1 to build against src/rum-stub.ts instead of the @ouo/browser package.
# VITE_RUM_STUB=1
# Set to 1 to enable SDK debug logging.
# VITE_RUM_DEBUG=1
