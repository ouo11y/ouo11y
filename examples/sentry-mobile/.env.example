# Copy to .env (gitignored). scripts/build-ios.sh reads it; values are baked into the Release build,
# so rebuild after a change. `scripts/build-ios.sh --env <name>` sets SENTRY_DSN and BACKEND_URL from
# an ouo-env instead.
#
# DSN of the ouo Sentry bridge (the collector's ouosentry receiver, port 4320 in the plain compose
# stack). The stack's bridge project is `1` with public key publickey000... and `upstream: none`, so
# nothing leaves your machine. To fan out to a real Sentry, set OUO_SENTRY_UPSTREAM (and the project
# id and key of your Sentry project) on the stack, not here: the app always talks to the bridge.
SENTRY_DSN=http://publickey0000000000000000000000@localhost:4320/1
# Demo backend (examples/backend); also the only tracePropagationTargets entry.
BACKEND_URL=http://localhost:8081
# Release sentry-demo@<APP_VERSION>+<BUILD_NUMBER>.
APP_VERSION=1.0.0
BUILD_NUMBER=1
# SENTRY_ENVIRONMENT (default development) also makes the Expo plugin write sentry.options.json;
# src/sentry.ts sets autoInitializeNativeSdk so the native SDK still starts.
# SENTRY_ENVIRONMENT=development
# Sentry only: never the ouo SDK next to the bridge (parallel mode makes ouo own `traceparent`, and
# both would report the same session to ouo). `memory` needs no flag server.
OUO_FLAG_PROVIDER=memory
OUO_RUM_MODE=sentry
# SENTRY_DEBUG=1
