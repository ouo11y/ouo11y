# Copy to .env (or .env.local) and adjust. Defaults match the stock ports in deploy/compose/.env.example.
# Collector OTLP/HTTP base URL (ouo-collector, the only public ingest, ADR-0007). The SDK sends OTLP to
# ${VITE_OTLP_ENDPOINT}/v1/{traces,logs}; replay chunks are OTLP log records on /v1/logs too.
# See deploy/compose/.env OUO_OTLP_HTTP_PORT.
VITE_OTLP_ENDPOINT=http://localhost:4318
# HTTP Basic project credentials sent as `Authorization: Basic base64(id:token)` on every ingest request.
# The token is not a secret: it only names the project. These are the development values the local
# stack is provisioned with (deploy/compose/.env.example OUO_PROJECT_ID / OUO_PROJECT_TOKEN); use your
# project's values elsewhere.
VITE_OUO_PROJECT_ID=demo
VITE_OUO_PROJECT_TOKEN=pt_dev_demo_0000000000000000
# Demo backend (examples/backend).
VITE_BACKEND_URL=http://localhost:8081
# Reported as service.version on every signal.
VITE_APP_VERSION=1.4.2
# Set to 1 to build against src/rum-stub.ts instead of the @ouo11y/browser package.
# VITE_RUM_STUB=1
# Set to 1 to enable SDK debug logging.
# VITE_RUM_DEBUG=1
# Sampling (fractions 0..1): sessions, and the share of them that record replay.
# VITE_OUO_SESSION_SAMPLE_RATE=1
# VITE_OUO_REPLAY_SAMPLE_RATE=1
# Replay mode: session (default), buffer (kept in memory, sent after an unhandled error) or off.
# VITE_OUO_REPLAY_MODE=session
# Replay format: structure (DOM description, text as ***; default) or pixel (masked images).
# VITE_OUO_REPLAY_FORMAT=structure
