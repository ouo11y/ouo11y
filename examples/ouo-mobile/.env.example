# Copy to .env and adjust only if your deploy/compose/.env overrides the stock ports or project.
# Expo CLI loads .env into process.env for app.config.ts, which passes these to the app via expo.extra.
# Collector OTLP/HTTP base URL (ADR-0007: the collector is the only endpoint the app talks to).
# Use the Mac's LAN IP for a physical iPhone.
EXPO_PUBLIC_OTLP_ENDPOINT=http://localhost:4318
# Replay goes to the same endpoint (`/v1/logs`, ADR-0021). Note: expo.extra is baked into the
# native build, so rebuild the app after changing any EXPO_PUBLIC_* value here.
# Project credential, sent as `Authorization: Basic base64(id:token)`. These are the development
# project of the stock compose stack (deploy/compose/.env.example, collector htpasswd); replace them
# with your project's id and token for any real deployment. The token is public by design.
EXPO_PUBLIC_OUO_PROJECT_ID=demo
EXPO_PUBLIC_OUO_PROJECT_TOKEN=pt_dev_demo_0000000000000000
# Demo backend (examples/backend).
BACKEND_URL=http://localhost:8081
# Reported as deployment.environment.name.
OUO_ENV=local
# Reported as service.version (app version in app.config.ts).
APP_VERSION=2.3.0
# Set to 1 to silence the LogBox overlay in the dev client.
# EXPO_PUBLIC_QUIET_LOGBOX=1
