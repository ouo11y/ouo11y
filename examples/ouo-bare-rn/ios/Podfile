require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Firebase-style apps link every pod as a static framework (Firebase's Swift pods need module maps
# and @react-native-firebase requires it). The example always does, so `use_expo_modules!` and the
# ouo pods are proven next to it. USE_FRAMEWORKS=dynamic still overrides, like the RN template.
linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

target 'OuoBare' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # The Firebase pods a JUHI-like app carries, linked (static frameworks) next to ExpoModulesCore and
  # the ouo pods. Not configured at runtime: the example has no GoogleService-Info.plist (README.md).
  # OUO_NO_FIREBASE=1 leaves them out.
  unless ENV['OUO_NO_FIREBASE'] == '1'
    pod 'FirebaseCore', '~> 12.0'
    pod 'FirebaseCrashlytics', '~> 12.0'
    pod 'FirebaseAnalytics', '~> 12.0'
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # React Native 0.82 ships fmt 11.0.2, whose consteval format strings Apple clang 21 (Xcode 27)
    # rejects ("call to consteval function ... is not a constant expression" in format-inl.h). Plain
    # React Native problem, not Expo's or ouo's: compile that one pod as C++17, where fmt turns consteval off.
    installer.pods_project.targets.each do |t|
      next unless t.name == 'fmt'
      t.build_configurations.each { |c| c.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17' }
    end
    # Xcode 27 refuses deployment targets below iOS 15.0 ("The iOS Simulator deployment target ... is
    # set to 12.0, but the range of supported deployment target versions is 15.0 to 27.0.x"). Older pods
    # declare them on their resource-bundle targets (GoogleDataTransport, GoogleUtilities, nanopb,
    # PromisesObjC, PromisesSwift, RNCAsyncStorage), which react_native_post_install does not touch.
    installer.pods_project.targets.each do |t|
      t.build_configurations.each do |c|
        target = c.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        c.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported if target && target.to_f < min_ios_version_supported.to_f
      end
    end
  end
end
